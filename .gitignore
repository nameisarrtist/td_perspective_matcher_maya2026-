# -*- coding: utf-8 -*-
"""TD Camera / Perspective Match / Blockout Workspace — Maya 2026 / PySide6.

Install in a Maya scripts directory, then:
    import td_perspective_matcher_maya2026 as tpm
    tpm.show()

Solves a rectilinear camera's orientation and focal length from orthogonal
vanishing directions. Translation, scene scale, and lens distortion are NOT
recoverable from these guides alone. NumPy is optional; OpenCV is not required.
Includes explicit camera/image-plane inspectors and a manual primitive blockout
workspace. Calibration JSON stores Match inputs only; save the Maya scene for
camera rigs, image planes, materials and meshes.
Maya commands and QPixmap operations remain on the main thread.
"""
from __future__ import annotations

import json
import math
import os
import sys
import tempfile
from contextlib import contextmanager
from dataclasses import dataclass
from itertools import combinations
from pathlib import Path
from typing import Any

import maya.cmds as cmds
import maya.mel as mel
import maya.utils
import maya.OpenMayaUI as omui
from PySide6 import QtCore, QtGui, QtWidgets
from shiboken6 import wrapInstance

