    from maya.app.general.mayaMixin import MayaQWidgetDockableMixin
    HAS_MIXIN = True
except ImportError:
    class MayaQWidgetDockableMixin:
        """Non-dockable fallback; intentionally not an alias for object."""
    HAS_MIXIN = False

try:
    import numpy as np
except ImportError:
    np = None

TITLE = "TD Perspective Matcher"
VERSION = "3.1.0"
OBJECT_NAME = "tdPerspectiveMatcher2026"
WORKSPACE = OBJECT_NAME + "WorkspaceControl"
OPTIONS = OBJECT_NAME + "_settings"
AXES = ("x", "y", "z")
AXIS_COLORS = {"x": "#ee7070", "y": "#79d28c", "z": "#73a9f5"}
SENSORS = [("Full frame", 36.0), ("Super 35", 24.89), ("Academy", 22.0),
           ("APS-C", 22.3), ("Micro 4/3", 17.3), ("Alexa 65", 54.12),
           ("Custom", None)]
CAMERA_TYPES = (("Free camera", "free"), ("Aim camera", "aim"),
                ("Blender-style film gate", "blender"))
# name, minimum, maximum, default, decimals, step
COLOR_SPECS = (("exposure", -4., 4., 0., 2, .1),
               ("brightness", -1., 1., 0., 2, .02),
               ("contrast", 0., 3., 1., 2, .05),
               ("gamma", .2, 4., 1., 2, .05),
               ("saturation", 0., 3., 1., 2, .05),
               ("opacity", 0., 1., 1., 2, .05))
COLOR_DEFAULTS = {s[0]: s[3] for s in COLOR_SPECS}
PREVIEW_EDGE = 1600
_UI = None


# ---------------------------------------------------------------------------
# Geometry: pure Python, independent of Maya scene state
# ---------------------------------------------------------------------------
def dot(a, b):
    return sum(x * y for x, y in zip(a, b))


def cross(a, b):
    return (a[1]*b[2] - a[2]*b[1], a[2]*b[0] - a[0]*b[2],
            a[0]*b[1] - a[1]*b[0])


def norm(v):
    length = math.sqrt(dot(v, v))
    if length < 1e-12 or not math.isfinite(length):
        raise ValueError("Degenerate direction. Separate the guides and try again.")
    return tuple(x / length for x in v)


def neg(v):
    return tuple(-x for x in v)


def finite_number(value, label="value"):
    if isinstance(value, bool):
        raise ValueError(f"{label} must be numeric, not Boolean.")
    result = float(value)
    if not math.isfinite(result):
        raise ValueError(f"{label} must be finite.")
    return result


def vanishing_point(lines):
    """Normalized homogeneous VP in image coordinates (x right, y down).

    Two nonzero segments are required. Parallel distinct lines produce a point
    at infinity; coincident lines are rejected instead of inventing a direction.
    """
    if len(lines) != 2:
        return None
    homogeneous = []
    for p, q in lines:
        a, b = p[1] - q[1], q[0] - p[0]
        length = math.hypot(a, b)
        if length < 4.0:
            raise ValueError("Guide segments must be at least 4 image pixels long.")
        homogeneous.append((a/length, b/length,
                            (p[0]*q[1] - q[0]*p[1])/length))
    v = cross(*homogeneous)
    if abs(v[2]) < 1e-8:
        length = math.hypot(v[0], v[1])
        if length < 1e-8:
            raise ValueError("Two guides overlap. Use separate parallel scene edges.")
        return (v[0]/length, v[1]/length, 0.0)
    return (v[0]/v[2], v[1]/v[2], 1.0)


def estimate_principal_point(vps, width, height):
    """Orthocenter of three finite orthogonal VPs, expressed center-relative/Y-up."""
    if any(a not in vps or abs(vps[a][2]) < 1e-12 for a in AXES):
        raise ValueError("Principal-point estimation needs three finite vanishing points.")
    a, b, c = [vps[k][:2] for k in AXES]
    # Intersect altitudes: (P-A).(C-B)=0 and (P-B).(C-A)=0.
    u = (c[0]-b[0], c[1]-b[1])
    v = (c[0]-a[0], c[1]-a[1])
    det = u[0]*v[1] - u[1]*v[0]
    if abs(det) < 1e-10 * max(1., math.hypot(*u)*math.hypot(*v)):
        raise ValueError("Vanishing-point triangle is too flat to estimate lens shift.")
    r, s = dot(a, u), dot(b, v)
    px, py = (r*v[1]-u[1]*s)/det, (u[0]*s-r*v[0])/det
    return (px-width*.5, height*.5-py)


@dataclass(frozen=True)
class SolveResult:
    focal_mm: float
    focal_px: float
    hfov: float
    principal: tuple
    camera_axes: tuple
    residual_degrees: float
    message: str


def solve_camera(lines, width, height, sensor_mm=36., principal=(0., 0.),
                 estimate_pp=False, fixed_focal_mm=None, flips=None):
    """Fit an orthonormal orientation; reject impossible/underdetermined inputs.

    Assumes square pixels, no skew, orthogonal scene axes and no distortion.
    VP signs are ambiguous: flip controls select the positive world directions.
    """
    if width <= 0 or height <= 0 or sensor_mm <= 0:
        raise ValueError("Image dimensions and sensor width must be positive.")
    vps = {ax: vanishing_point(lines.get(ax, [])) for ax in AXES}
    vps = {ax: v for ax, v in vps.items() if v is not None}
    if len(vps) < 2:
        raise ValueError("Draw two guides on each of at least two world axes.")
    pp = estimate_principal_point(vps, width, height) if estimate_pp else principal
    # Homogeneous camera-plane coordinates; infinity remains well-defined.
    xy = {ax: (v[0]-(width*.5+pp[0])*v[2],
               (height*.5-pp[1])*v[2]-v[1], v[2]) for ax, v in vps.items()}
    finite = [v for v in xy.values() if v[2] != 0.]
    fixed = fixed_focal_mm is not None
    if fixed:
        focal = finite_number(fixed_focal_mm, "Focal length") * width / sensor_mm
        if focal <= 0:
            raise ValueError("Focal length must be positive.")
    else:
        samples = [-(a[0]*b[0]+a[1]*b[1]) for a, b in combinations(finite, 2)]
        if not samples:
            raise ValueError("Focal length is underdetermined. Enable Known focal length "
                             "or provide two finite vanishing points.")
        if any(v <= 1e-6 for v in samples):
            raise ValueError("Guides do not describe orthogonal directions for this "
                             "principal point. Refine the lines, lens shift, or axis labels.")
        focal = math.sqrt(sum(samples)/len(samples))
    focal_mm = focal*sensor_mm/width
    if not 1.0 <= focal_mm <= 10000.0:
        raise ValueError(f"Implausible focal length ({focal_mm:.3f} mm). Check guides/sensor.")
    directions = {}
    for ax, v in xy.items():
        d = norm((v[0], v[1], -focal*v[2]))
        directions[ax] = neg(d) if (flips or {}).get(ax, False) else d
    residual = max(math.degrees(math.asin(min(1., abs(dot(a, b)))))
                   for a, b in combinations(directions.values(), 2))
    if residual > 8.0:
        raise ValueError(f"Orthogonality error is {residual:.2f}°. Refine the guides "
                         "or correct the focal length/principal point.")
    if "x" not in directions:
        directions["x"] = norm(cross(directions["y"], directions["z"]))
    elif "y" not in directions:
        directions["y"] = norm(cross(directions["z"], directions["x"]))
    elif "z" not in directions:
        directions["z"] = norm(cross(directions["x"], directions["y"]))
    # A sign choice with negative determinant cannot be a camera rotation.
    if dot(cross(directions["x"], directions["y"]), directions["z"]) <= 0:
        raise ValueError("Axis signs form a left-handed frame. Toggle one axis flip.")
    if np is not None:
        matrix = np.array([directions[a] for a in AXES], dtype=float).T
        u, _, vt = np.linalg.svd(matrix)
        fitted = u @ vt
        if np.linalg.det(fitted) < 0:
            u[:, -1] *= -1
            fitted = u @ vt
        columns = [tuple(float(x) for x in fitted[:, i]) for i in range(3)]
    else:
        x = directions["x"]
        z = norm(cross(x, directions["y"]))
        columns = [x, norm(cross(z, x)), z]
    # World-to-camera columns -> camera-to-world rows (Maya row-vector matrix).
    camera_axes = tuple(tuple(columns[j][i] for j in range(3)) for i in range(3))
    message = "Known focal length" if fixed else "Focal length solved from orthogonal VPs"
    if estimate_pp:
        message += "; principal point estimated"
    return SolveResult(focal_mm, focal, math.degrees(2*math.atan(width/(2*focal))),
                       tuple(pp), camera_axes, residual, message)


# ---------------------------------------------------------------------------
# Maya scene operations — main thread only
# ---------------------------------------------------------------------------
def maya_main_window():
    pointer = omui.MQtUtil.mainWindow()
    return wrapInstance(int(pointer), QtWidgets.QWidget) if pointer else None


@contextmanager
def undo_chunk(name):
    cmds.undoInfo(openChunk=True, chunkName=name)
    try:
        yield
    finally:
        cmds.undoInfo(closeChunk=True)


def camera_nodes(node):
    if not node or not cmds.objExists(node):
        raise ValueError("Select an existing camera.")
    if cmds.nodeType(node) == "camera":
        shape = (cmds.ls(node, long=True) or [node])[0]
        transform = cmds.listRelatives(shape, parent=True, fullPath=True)[0]
    else:
        transform = (cmds.ls(node, long=True) or [node])[0]
        shapes = cmds.listRelatives(transform, shapes=True, type="camera", fullPath=True) or []
        if not shapes:
            raise ValueError(f"Not a camera: {node}")
        shape = shapes[0]
    return transform, shape


def managed_aim(transform):
    if not cmds.attributeQuery("tpmAimConstraint", node=transform, exists=True):
        return None
    connected = cmds.listConnections(transform+".tpmAimConstraint", source=True,
                                     destination=False, type="aimConstraint") or []
    return connected[0] if connected else None


def create_camera(kind):
    with undo_chunk("TPM_CreateCamera"):
        transform, shape = cmds.camera(name="perspectiveMatch_CAM")
        cmds.setAttr(transform+".translate", 0, 0, 10, type="double3")
        cmds.setAttr(shape+".filmFit", 1)  # horizontal
        if kind == "aim":
            target = cmds.spaceLocator(name="perspectiveMatch_AIM")[0]
            constraint = cmds.aimConstraint(target, transform, aimVector=(0, 0, -1),
                                           upVector=(0, 1, 0), worldUpType="vector",
                                           worldUpVector=(0, 1, 0))[0]
            cmds.addAttr(transform, longName="tpmAimConstraint", attributeType="message")
            cmds.connectAttr(constraint+".message", transform+".tpmAimConstraint")
        if kind == "blender":
            cmds.setAttr(shape+".overscan", 1.)
            cmds.setAttr(shape+".displayGateMaskOpacity", .65)
        cmds.setAttr(shape+".displayResolution", True)
        cmds.setAttr(shape+".displayGateMask", True)
    return camera_nodes(transform)[0]


def find_image_plane(shape):
    planes = cmds.listConnections(shape+".imagePlane", source=True,
                                  destination=False, type="imagePlane") or []
    return planes[0] if planes else None


def apply_plane_color(plane, color):
    # Maya image-plane attributes cannot reproduce contrast/gamma/saturation.
    gain = 2.**color["exposure"]
    cmds.setAttr(plane+".colorGain", gain, gain, gain, type="double3")
    value = color["brightness"]
    cmds.setAttr(plane+".colorOffset", value, value, value, type="double3")
    cmds.setAttr(plane+".alphaGain", color["opacity"])


def require_editable(plug, allowed_source=None):
    if cmds.getAttr(plug, lock=True):
        raise ValueError(f"Locked attribute: {plug}")
    sources = cmds.listConnections(plug, source=True, destination=False, plugs=True) or []
    for source in sources:
        if allowed_source and cmds.ls(source.split(".")[0], long=True) == cmds.ls(allowed_source, long=True):
            continue
        raise ValueError(f"Driven attribute: {plug} ← {source}. Use a new match camera.")


def apply_camera(node, solution, width, height, sensor, near, far, image="", color=None, plane_node=None):
    transform, shape = camera_nodes(node)
    if cmds.getAttr(shape+".orthographic"):
        raise ValueError("Orthographic cameras cannot receive a perspective match.")
    if near <= 0 or far <= near:
        raise ValueError("Clipping planes must satisfy 0 < near < far.")
    if image and not os.path.isfile(image):
        raise ValueError(f"Reference image no longer exists: {image}")
    if image and plane_node:
        attached = cmds.listConnections(shape+".imagePlane", source=True,
                                        destination=False, type="imagePlane") or []
        full_attached = [p for item in attached for p in (cmds.ls(item, long=True) or [])]
        if plane_node not in full_attached:
            raise ValueError("Selected image plane is not attached to the target camera. Refresh Images.")
    # Pan/zoom, squeeze and pre/post scale would invalidate the pinhole model.
    calibration = {"horizontalFilmAperture": sensor/25.4,
                   "verticalFilmAperture": sensor/25.4*height/width,
                   "focalLength": solution.focal_mm, "filmFit": 1,
                   # Filmback displacement has the opposite sign to image principal point.
                   "horizontalFilmOffset": -solution.principal[0]/width*sensor/25.4,
                   "verticalFilmOffset": -solution.principal[1]/height*(sensor/25.4*height/width),
                   "nearClipPlane": near, "farClipPlane": far,
                   "lensSqueezeRatio": 1., "cameraScale": 1.,
                   "preScale": 1., "postScale": 1., "filmFitOffset": 0.,
                   "filmTranslateH": 0., "filmTranslateV": 0., "filmRollValue": 0.,
                   "panZoomEnabled": False, "shakeEnabled": False}
    aim = managed_aim(transform)
    targets = cmds.aimConstraint(aim, query=True, targetList=True) if aim else []
    if aim and len(targets) != 1:
        raise ValueError("The managed aim camera must have exactly one aim target.")
    for attr in calibration:
        require_editable(shape+"."+attr)
    for channel in ("rotateX", "rotateY", "rotateZ"):
        require_editable(transform+"."+channel, allowed_source=aim)
    if aim:
        for channel in ("translateX", "translateY", "translateZ"):
            require_editable(targets[0]+"."+channel)
    else:
        for attr in ("translateX", "translateY", "translateZ", "scaleX", "scaleY", "scaleZ"):
            require_editable(transform+"."+attr)
    position = cmds.xform(transform, query=True, worldSpace=True, translation=True)
    xa, ya, za = solution.camera_axes
    plane = None
    with undo_chunk("TPM_ApplyMatch"):
        for attr, value in calibration.items():
            cmds.setAttr(shape+"."+attr, value)
        if aim:
            old_target = cmds.xform(targets[0], query=True, worldSpace=True, translation=True)
            distance = max(1., math.sqrt(sum((a-b)**2 for a, b in zip(position, old_target))))
            cmds.aimConstraint(aim, edit=True, aimVector=(0, 0, -1), upVector=(0, 1, 0),
                               worldUpType="vector", worldUpVector=ya, offset=(0, 0, 0))
            cmds.xform(targets[0], worldSpace=True,
                       translation=tuple(position[i]-za[i]*distance for i in range(3)))
        else:
            matrix = [*xa, 0., *ya, 0., *za, 0., *position, 1.]
            cmds.xform(transform, worldSpace=True, matrix=matrix)
        cmds.setAttr(shape+".displayResolution", True)
        cmds.setAttr(shape+".displayGateMask", True)
        if image:
            if not os.path.isfile(image):
                raise ValueError(f"Reference image no longer exists: {image}")
            plane = plane_node or find_image_plane(shape)
            if not plane:
                _, plane = cmds.imagePlane(camera=shape, fileName=image)
            else:
                cmds.setAttr(plane+".imageName", image, type="string")
            cmds.setAttr(plane+".fit", 1)  # match best; film and image aspects agree
            cmds.setAttr(plane+".displayOnlyIfCurrent", True)
            if color is not None:
                apply_plane_color(plane, color)
    return transform, plane


# ---------------------------------------------------------------------------
# Image processing — worker uses only QImage/NumPy, never Maya or QPixmap
# ---------------------------------------------------------------------------
def correct_image(image, params):
    if np is None or all(abs(params[k]-COLOR_DEFAULTS[k]) < 1e-8
                         for k in COLOR_DEFAULTS if k != "opacity"):
        return image.copy()
    source = image.convertToFormat(QtGui.QImage.Format.Format_RGBA8888)
    w, h = source.width(), source.height()
    raw = np.frombuffer(source.constBits(), dtype=np.uint8, count=source.sizeInBytes())
    rgba = raw.reshape(h, source.bytesPerLine())[:, :w*4].reshape(h, w, 4)
    rgb = rgba[..., :3].astype(np.float32)/255.
    rgb = rgb*(2.**params["exposure"]) + params["brightness"]
    rgb = (rgb-.5)*params["contrast"] + .5
    np.clip(rgb, 0., 1., out=rgb)
    rgb **= 1./params["gamma"]
    lum = (rgb @ np.array([.2126, .7152, .0722], dtype=np.float32))[..., None]
    rgb = lum + (rgb-lum)*params["saturation"]
    np.clip(rgb, 0., 1., out=rgb)
    out = np.empty((h, w, 4), dtype=np.uint8)
    out[..., :3] = (rgb*255.+.5).astype(np.uint8)
    out[..., 3] = rgba[..., 3]  # preserve source transparency
    return QtGui.QImage(out.data, w, h, w*4,
                        QtGui.QImage.Format.Format_RGBA8888).copy()


class WorkerSignals(QtCore.QObject):
    complete = QtCore.Signal(int, object, str)


class ColorWorker(QtCore.QRunnable):
    def __init__(self, generation, image, params):
        super().__init__()
        self.generation, self.image, self.params = generation, image, params
        self.signals = WorkerSignals()

    def run(self):
        try:
            self.signals.complete.emit(self.generation, correct_image(self.image, self.params), "")
        except Exception as exc:
            self.signals.complete.emit(self.generation, None, str(exc))


# ---------------------------------------------------------------------------
# Canvas: native-resolution scene coordinates, bounded guide count
# ---------------------------------------------------------------------------
class Handle(QtWidgets.QGraphicsEllipseItem):
    def __init__(self, color, callback):
        super().__init__(-5, -5, 10, 10)
        self.callback = callback
        self.setBrush(QtGui.QColor(color))
        self.setPen(QtGui.QPen(QtGui.QColor("#f5f5f5"), 1.2))
        flags = QtWidgets.QGraphicsItem.GraphicsItemFlag
        self.setFlags(flags.ItemIsMovable | flags.ItemSendsGeometryChanges |
                      flags.ItemIgnoresTransformations)
        self.setCursor(QtCore.Qt.CursorShape.SizeAllCursor)
        self.setZValue(20)

    def itemChange(self, change, value):
        if change == QtWidgets.QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            if self.callback:
                self.callback()
        return super().itemChange(change, value)


class Guide:
    def __init__(self, scene, axis, points, changed):
        self.scene, self.changed = scene, changed
        pen = QtGui.QPen(QtGui.QColor(AXIS_COLORS[axis]), 1.8)
        pen.setCosmetic(True)
        self.line = scene.addLine(QtCore.QLineF(), pen)
        self.line.setZValue(10)
        self.handles = [Handle(AXIS_COLORS[axis], None) for _ in range(2)]
        for handle, point in zip(self.handles, points):
            scene.addItem(handle)
            handle.setPos(*point)
            handle.callback = self.sync
        self.sync(notify=False)

    def points(self):
        return [(h.pos().x(), h.pos().y()) for h in self.handles]

    def sync(self, notify=True):
        self.line.setLine(QtCore.QLineF(self.handles[0].pos(), self.handles[1].pos()))
        if notify:
            self.changed()

    def remove(self):
        for handle in self.handles:
            handle.callback = None
        for item in [self.line, *self.handles]:
            self.scene.removeItem(item)


class Canvas(QtWidgets.QGraphicsView):
    changed = QtCore.Signal()
    message = QtCore.Signal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setScene(QtWidgets.QGraphicsScene(self))
        self.setRenderHints(QtGui.QPainter.RenderHint.Antialiasing |
                            QtGui.QPainter.RenderHint.SmoothPixmapTransform)
        self.setBackgroundBrush(QtGui.QColor("#171b22"))
        self.setTransformationAnchor(self.ViewportAnchor.AnchorUnderMouse)
        self.setMinimumSize(480, 360)
        self.width_px = self.height_px = 0
        self.guides = {ax: [] for ax in AXES}
        self.axis = "x"
        self.pixmap = None
        self.base = None
        self.original = False
        self.color = COLOR_DEFAULTS.copy()
        self.grid = False
        self.grid_size = 100
        self.rubber = None
        self.start = None
        self.pan = None
        self.zoom = 1.
        self.generation = 0
        self.active = False
        self.stopping = False
        self.pool = QtCore.QThreadPool(self)
        self.pool.setMaxThreadCount(1)
        self.timer = QtCore.QTimer(self)
        self.timer.setSingleShot(True)
        self.timer.setInterval(90)
        self.timer.timeout.connect(self.refresh)
        self.setToolTip("Left drag: draw • Drag endpoint: adjust • Middle drag: pan • Wheel: zoom")

    @staticmethod
    def read_image(path):
        reader = QtGui.QImageReader(str(path))
        # Do not apply EXIF orientation: maintain coordinates used by Maya's plane.
        reader.setAutoTransform(False)
        image = reader.read()
        if image.isNull():
            raise ValueError("Cannot decode image with this Qt installation: " +
                             reader.errorString() + "\nConvert EXR/HDR references to PNG/TIFF first.")
        return image

    def load(self, path, image=None):
        image = image if image is not None else self.read_image(path)
        self.cancel_drawing()
        for guides in self.guides.values():
            for guide in guides:
                for handle in guide.handles:
                    handle.callback = None
        self.guides = {ax: [] for ax in AXES}
        self.scene().clear()
        self.pixmap = None
        self.width_px, self.height_px = image.width(), image.height()
        if max(self.width_px, self.height_px) > PREVIEW_EDGE:
            image = image.scaled(PREVIEW_EDGE, PREVIEW_EDGE,
                                 QtCore.Qt.AspectRatioMode.KeepAspectRatio,
                                 QtCore.Qt.TransformationMode.SmoothTransformation)
        self.base = image.copy()
        self.pixmap = self.scene().addPixmap(QtGui.QPixmap.fromImage(self.base))
        self.pixmap.setTransformationMode(QtCore.Qt.TransformationMode.SmoothTransformation)
        self.pixmap.setTransform(QtGui.QTransform.fromScale(
            self.width_px/self.base.width(), self.height_px/self.base.height()))
        self.scene().setSceneRect(0, 0, self.width_px, self.height_px)
        self.schedule()
        self.fit()
        self.changed.emit()

    def fit(self):
        if self.pixmap is not None:
            self.fitInView(self.sceneRect(), QtCore.Qt.AspectRatioMode.KeepAspectRatio)
            self.zoom = 1.

    def line_data(self):
        return {ax: [guide.points() for guide in self.guides[ax]] for ax in AXES}

    def restore(self, lines):
        self.clear()
        for ax in AXES:
            self.guides[ax] = [Guide(self.scene(), ax, points, self.changed.emit)
                               for points in lines.get(ax, [])]
        self.changed.emit()

    def clear(self, axis=None):
        self.cancel_drawing()
        for ax in ([axis] if axis else AXES):
            for guide in self.guides[ax]:
                guide.remove()
            self.guides[ax] = []
        self.changed.emit()

    def set_color(self, params):
        self.color = params.copy()
        self.schedule()

    def schedule(self):
        self.generation += 1
        self.timer.start()

    def refresh(self):
        if self.base is None or self.stopping:
            return
        if self.original or np is None:
            self.pixmap.setPixmap(QtGui.QPixmap.fromImage(self.base))
            self.pixmap.setOpacity(1. if self.original else self.color["opacity"])
            return
        if self.active:
            return  # completion schedules the newest generation, not stale queued jobs
        self.active = True
        worker = ColorWorker(self.generation, self.base.copy(), self.color.copy())
        worker.signals.complete.connect(self.color_ready, QtCore.Qt.ConnectionType.QueuedConnection)
        self.pool.start(worker)

    @QtCore.Slot(int, object, str)
    def color_ready(self, generation, image, error):
        self.active = False
        if self.stopping:
            return
        if generation != self.generation:
            self.timer.start()
            return
        if error:
            self.message.emit("Preview correction failed: " + error)
        elif image is not None and self.pixmap is not None:
            self.pixmap.setPixmap(QtGui.QPixmap.fromImage(image))
            self.pixmap.setOpacity(1. if self.original else self.color["opacity"])

    def shutdown(self):
        self.stopping = True
        self.generation += 1
        self.timer.stop()
        self.pool.clear()
        self.pool.waitForDone()  # bounded 1600px jobs; no Maya/UI calls in worker

    def drawForeground(self, painter, rect):
        super().drawForeground(painter, rect)
        if not self.grid or self.pixmap is None:
            return
        painter.save()
        painter.setClipRect(self.sceneRect())
        pen = QtGui.QPen(QtGui.QColor(170, 185, 210, 65), 1,
                         QtCore.Qt.PenStyle.DotLine)
        pen.setCosmetic(True)
        painter.setPen(pen)
        visible = rect.intersected(self.sceneRect())
        step = self.grid_size
        # Keep a bounded number of lines when zoomed out on huge references.
        while (visible.width()+visible.height())/step > 500:
            step *= 2
        for x in range(int(visible.left()//step)*step, int(visible.right())+1, step):
            painter.drawLine(QtCore.QPointF(x, 0), QtCore.QPointF(x, self.height_px))
        for y in range(int(visible.top()//step)*step, int(visible.bottom())+1, step):
            painter.drawLine(QtCore.QPointF(0, y), QtCore.QPointF(self.width_px, y))
        painter.restore()

    def cancel_drawing(self):
        if self.rubber is not None:
            self.scene().removeItem(self.rubber)
        self.rubber = self.start = None

    def wheelEvent(self, event):
        if self.pixmap is None or event.angleDelta().y() == 0:
            return
        factor = 1.15 if event.angleDelta().y() > 0 else 1/1.15
        if .05 <= self.zoom*factor <= 60.:
            self.zoom *= factor
            self.scale(factor, factor)
        event.accept()

    def mousePressEvent(self, event):
        if event.button() == QtCore.Qt.MouseButton.MiddleButton:
            self.pan = event.position().toPoint()
            self.setCursor(QtCore.Qt.CursorShape.ClosedHandCursor)
            event.accept()
            return
        if event.button() == QtCore.Qt.MouseButton.RightButton:
            self.cancel_drawing()
            event.accept()
            return
        if event.button() == QtCore.Qt.MouseButton.LeftButton and self.pixmap is not None:
            point = self.mapToScene(event.position().toPoint())
            if not isinstance(self.itemAt(event.position().toPoint()), Handle):
                self.start = point
                pen = QtGui.QPen(QtGui.QColor(AXIS_COLORS[self.axis]), 1.5,
                                 QtCore.Qt.PenStyle.DashLine)
                pen.setCosmetic(True)
                self.rubber = self.scene().addLine(QtCore.QLineF(point, point), pen)
                self.rubber.setZValue(12)
                event.accept()
                return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if self.pan is not None:
            point = event.position().toPoint()
            delta = point-self.pan
            self.pan = point
            self.horizontalScrollBar().setValue(self.horizontalScrollBar().value()-delta.x())
            self.verticalScrollBar().setValue(self.verticalScrollBar().value()-delta.y())
            event.accept()
            return
        if self.rubber is not None:
            self.rubber.setLine(QtCore.QLineF(self.start, self.mapToScene(event.position().toPoint())))
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if event.button() == QtCore.Qt.MouseButton.MiddleButton:
            self.pan = None
            self.unsetCursor()
            event.accept()
            return
        if event.button() == QtCore.Qt.MouseButton.LeftButton and self.rubber is not None:
            start = self.start
            end = self.mapToScene(event.position().toPoint())
            self.cancel_drawing()
            if QtCore.QLineF(start, end).length() >= 4.:
                guides = self.guides[self.axis]
                if len(guides) == 2:
                    guides.pop(0).remove()
                guides.append(Guide(self.scene(), self.axis,
                                    [(start.x(), start.y()), (end.x(), end.y())], self.changed.emit))
                self.changed.emit()
            event.accept()
            return
        super().mouseReleaseEvent(event)

    def keyPressEvent(self, event):
        if event.key() == QtCore.Qt.Key.Key_Escape:
            self.cancel_drawing()
            return
        if event.key() == QtCore.Qt.Key.Key_F:
            self.fit()
            return
        super().keyPressEvent(event)


# ---------------------------------------------------------------------------
# Calibration I/O: validate before touching UI; atomic saves
# ---------------------------------------------------------------------------
def validate_payload(data):
    if not isinstance(data, dict):
        raise ValueError("Calibration must be a JSON object.")
    version = data.get("version", 4)
    if version not in (4, 5):
        raise ValueError(f"Unsupported calibration schema: {version}")
    size = data.get("image_size")
    if not isinstance(size, list) or len(size) != 2:
        raise ValueError("Calibration needs image_size: [width, height].")
    size = [finite_number(v, "Image size") for v in size]
    if any(v <= 0 or v != int(v) for v in size):
        raise ValueError("Image dimensions must be positive integers.")
    result = {"version": 5, "image_size": [int(v) for v in size],
              "image": str(data.get("image", "")), "lines": {}, "flips": {}}
    for ax in AXES:
        segments = data.get("lines", {}).get(ax, [])
        if not isinstance(segments, list) or len(segments) > 2:
            raise ValueError(f"Axis {ax}: expected at most two segments.")
        clean = []
        for segment in segments:
            if not isinstance(segment, (list, tuple)) or len(segment) != 2:
                raise ValueError(f"Axis {ax}: each segment requires two endpoints.")
            points = []
            for p in segment:
                if not isinstance(p, (list, tuple)) or len(p) != 2:
                    raise ValueError("Each endpoint must contain two coordinates.")
                points.append(tuple(finite_number(v, "Guide coordinate") for v in p))
            if math.dist(*points) < 4.:
                raise ValueError("Calibration contains a zero-length or too-short guide.")
            clean.append(points)
        result["lines"][ax] = clean
        flip = data.get("flips", {}).get(ax, False)
        if not isinstance(flip, bool):
            raise ValueError("Axis flips must be Boolean.")
        result["flips"][ax] = flip
    sensor = finite_number(data.get("sensor_mm", 36), "Sensor width")
    if not 1 <= sensor <= 100:
        raise ValueError("Sensor width must be between 1 and 100 mm.")
    result["sensor_mm"] = sensor
    result["color"] = {}
    for name, lo, hi, default, _, _ in COLOR_SPECS:
        value = finite_number(data.get("color", {}).get(name, default), name)
        if not lo <= value <= hi:
            raise ValueError(f"{name} is outside its supported range.")
        result["color"][name] = value
    settings = data.get("camera_settings", {})
    near = finite_number(settings.get("near_clip", .1), "Near clip")
    far = finite_number(settings.get("far_clip", 10000), "Far clip")
    if not .001 <= near < far <= 1e8:
        raise ValueError("Invalid clipping-plane range.")
    shift = settings.get("lens_shift", [0, 0])
    if not isinstance(shift, (list, tuple)) or len(shift) != 2:
        raise ValueError("Lens shift must contain two values.")
    shift = [finite_number(v, "Lens shift") for v in shift]
    if any(abs(v) > 2 for v in shift):
        raise ValueError("Lens shift must be between -2 and 2.")
    focal = finite_number(settings.get("focal_mm", 35), "Known focal length")
    if not 1 <= focal <= 10000:
        raise ValueError("Known focal length must be between 1 and 10000 mm.")
    result["camera_settings"] = {"near_clip": near, "far_clip": far, "lens_shift": shift,
                                 "focal_mm": focal}
    for flag in ("known_focal", "estimate_pp"):
        value = settings.get(flag, False)
        if not isinstance(value, bool):
            raise ValueError(f"{flag} must be Boolean.")
        result["camera_settings"][flag] = value
    kind = str(data.get("camera_type", "free")).lower()
    if kind not in {v for _, v in CAMERA_TYPES}:
        raise ValueError(f"Unsupported camera type: {kind}")
    result["camera_type"] = kind
    return result


def atomic_json(path, payload):
    path = Path(path)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=str(path.parent),
                                         prefix=".tpm_", suffix=".tmp", delete=False) as stream:
            temporary = stream.name
            json.dump(payload, stream, indent=2, ensure_ascii=False, allow_nan=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, str(path))
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)


# ---------------------------------------------------------------------------
# Camera / image-plane attribute workspace and manual blockout tools
# ---------------------------------------------------------------------------
# All edits are explicit button actions: loading an inspector never writes scene data.
